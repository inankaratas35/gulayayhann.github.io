<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Levent Efe (@leventcodes) · Kodlar ve linkler</title>
<meta name="description" content="Yazılım öğrenen bir öğrenci. Instagram'da paylaştığım animasyonların canlı hali, kodları ve linklerim.">
<meta name="theme-color" content="#0a0a0a">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:title" content="Levent Efe · @leventcodes">
<meta property="og:description" content="Kodladıklarım burada: canlı izle, kodu gör, indir.">
<meta property="og:image" content="https://leventefe06.github.io/assets/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="tr_TR">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/kodlar/kasimpati/kapak.webp" as="image">
<link rel="stylesheet" href="/assets/stil.css">
</head>
<body>
<main class="sayfa">
  <header class="profil">
    <div class="avatar" id="avatar"><span class="harf">LE</span></div>
    <h1 id="ad">Levent Efe</h1>
    <p class="kullanici" id="kullanici">@leventcodes</p>
    <p class="rol" id="rol">Yazılım Geliştirme öğrencisi · Ankara</p>
    <p class="bio" id="bio">Yazılım öğrenen bir öğrenci. Kodladıklarım burada.</p>
  </header>

  <section aria-labelledby="b-kodlar">
    <h2 class="bolum" id="b-kodlar"><span>Kodlar</span><span class="sayi" id="kod-sayisi"></span></h2>
    <ul class="liste" id="kodlar"></ul>
  </section>

  <section aria-labelledby="b-linkler">
    <h2 class="bolum" id="b-linkler"><span>Linkler</span></h2>
    <ul class="liste" id="linkler"></ul>
  </section>

  <footer class="alt">
    <a class="alt-ig" href="https://instagram.com/leventcodes" aria-label="Instagram: @leventcodes" id="alt-ig"></a>
    <p>© 2026 Levent Efe · Bu sayfayı ben kodladım</p>
  </footer>
</main>
<noscript><p class="noscript">Bu sayfa için JavaScript gerekiyor.</p></noscript>
<script src="/assets/veri.js"></script>
<script src="/assets/ikonlar.js"></script>
<script src="/assets/ana.js"></script>
</body>
</html>
